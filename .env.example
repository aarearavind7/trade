ALPACA_API_KEY_ID=your_paper_api_key
ALPACA_API_SECRET_KEY=your_paper_secret_key
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# IEX is exchange-specific real-time data, not a consolidated market feed.
# sip requires an entitlement; delayed_sip is delayed.
ALPACA_DATA_FEED=iex
MAX_POSITION_PCT=20
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS=1000
TRADING_DB_PATH=trading_app/data/orders.sqlite3
# Required when exposing the API outside localhost. Use a long random value.
API_ACCESS_TOKEN=
# Exact hosted dashboard origin, if frontend and API are on different hosts.
ALLOWED_ORIGINS=
# Add your API hostname when deploying; no scheme or port.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Without Alpaca configuration, display read-only Yahoo Finance market data.
# Timing is not guaranteed; this public feed is never used for order submission.
PUBLIC_MARKET_DATA=true
